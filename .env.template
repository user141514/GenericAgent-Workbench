# GenericAgent Workbench API Configuration
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env to version control (it is already in .gitignore)

# Required: Your API key for the LLM provider
GA_API_KEY=your_api_key_here

# Optional: Backend display name
GA_BACKEND_NAME=deepseek-v4-pro

# Optional: API base URL (defaults shown)
GA_API_BASE_URL=https://api.deepseek.com
GA_MODEL=deepseek-chat
GA_STREAM=false
GA_MAX_RETRIES=3
GA_CONNECT_TIMEOUT=10
GA_READ_TIMEOUT=120
