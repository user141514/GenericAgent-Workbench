# GenericAgent Workbench — API Key Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control (already in .gitignore).
#
# TWO configuration paths are available:
#   Path A (recommended): mykey_template.py → mykey.py
#       Multi-key, multi-backend. Works with both backends.
#   Path B (minimal): .env.template → .env
#       Single-key. Works with GA_AGENT_BACKEND=openai-agents.

# ── Required ──
GA_API_KEY=your_api_key_here

# ── Optional: single-key tuning ──
GA_BACKEND_NAME=deepseek-v4-pro
GA_API_BASE_URL=https://api.deepseek.com
GA_MODEL=deepseek-chat
GA_STREAM=false
GA_MAX_RETRIES=3
GA_CONNECT_TIMEOUT=10
GA_READ_TIMEOUT=120

# ── Optional: multi-key (Path A users who prefer env vars) ──
# GA_KEY1_API_KEY=sk-xxx
# GA_KEY1_NAME=primary-model
# GA_KEY1_API_BASE=https://api.deepseek.com
# GA_KEY1_MODEL=deepseek-chat
#
# GA_KEY2_API_KEY=sk-yyy
# GA_KEY2_NAME=secondary-model
# GA_KEY2_API_BASE=https://api.openai.com/v1
# GA_KEY2_MODEL=gpt-4o
